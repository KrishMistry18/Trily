# =============================================================================
# Orbis — Required Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/orbis"

# -----------------------------------------------------------------------------
# NextAuth.js
# -----------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars"

# Google OAuth provider
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# -----------------------------------------------------------------------------
# AI Provider — choose "anthropic" or "openai"
# -----------------------------------------------------------------------------
AI_PROVIDER="anthropic"
AI_API_KEY="your-ai-api-key"

# Anthropic model (used when AI_PROVIDER=anthropic)
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# OpenAI model (used when AI_PROVIDER=openai)
OPENAI_MODEL="gpt-4o"

# -----------------------------------------------------------------------------
# Image Generation — choose "replicate" or "fal"
# -----------------------------------------------------------------------------
IMAGE_PROVIDER="replicate"
REPLICATE_API_TOKEN="your-replicate-api-token"
FAL_API_KEY="your-fal-api-key"

# -----------------------------------------------------------------------------
# Storage (AWS S3 or Cloudflare R2)
# -----------------------------------------------------------------------------
S3_REGION="auto"
S3_BUCKET_NAME="orbis-assets"
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
# For Cloudflare R2: https://{accountId}.r2.cloudflarestorage.com
# Leave empty for standard AWS S3
S3_ENDPOINT=""

# -----------------------------------------------------------------------------
# Redis (BullMQ queue + rate limiter)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# Stripe Billing
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"
STRIPE_PRICE_PRO_MONTHLY="price_your-pro-monthly-price-id"
STRIPE_PRICE_BUSINESS_MONTHLY="price_your-business-monthly-price-id"
# Public key — safe to expose to the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"

# -----------------------------------------------------------------------------
# Vercel Deployment (server-side only — never expose to client)
# -----------------------------------------------------------------------------
VERCEL_API_TOKEN="your-vercel-api-token"

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS="5"
RATE_LIMIT_WINDOW_MS="60000"

# -----------------------------------------------------------------------------
# BullMQ Worker
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY="3"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
